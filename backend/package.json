{
  "name": "@paris-bites/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:inventory": "tsx prisma/seed-inventory.cli.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "prisma:seed:menu": "tsx prisma/seed-menu.cli.ts",
    "verify:idempotency": "node --env-file=.env scripts/verify-idempotency.mjs",
    "verify:order-race": "node --env-file=.env scripts/verify-order-race.mjs",
    "clean:test-orders": "tsx --env-file=.env scripts/clean-test-orders.mts",
    "inventory:mirror-locations": "tsx --env-file=.env scripts/mirror-inventory-locations.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.1",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
