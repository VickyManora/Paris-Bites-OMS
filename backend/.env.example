# ============================================================================
# Paris Bites API — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# Every variable here is validated at startup by src/config/env.ts.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paris_bites?schema=public"
#
# Neon (production) — use the POOLED connection string for the app, and add
# `&connect_timeout=15`. Neon's pooler is what keeps a serverless-ish workload
# from exhausting Postgres connections:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/paris_bites?sslmode=require"
#
# Migrations must run against the DIRECT (non-pooled) endpoint — the pooler does
# not support the advisory locks Prisma Migrate needs:
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/paris_bites?sslmode=require"

# Maximum simultaneous database connections this process holds.
#
# Unset it defaults to 1 in development and 10 in production. That gap is a
# CORRECTNESS requirement, not tuning: `prisma dev` runs PGlite (Postgres compiled
# to WebAssembly) and multiplexes every connection onto ONE backend session, so a
# transaction on one connection and a query on another interleave inside that
# session and corrupt it — seen as "bind message supplies N parameters, but
# prepared statement \"\" requires 0" or a dropped connection. At 1, the driver
# serialises everything and the overlap cannot happen.
#
# Raise it when you point this at a REAL Postgres. Serialising is pure cost there,
# and it also means local load cannot exercise the row-locking that stock
# adjustments rely on. A real local Postgres, for example:
#   docker run --name paris-bites-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=paris_bites -p 5432:5432 -d postgres:17
# then set DATABASE_URL to that and DATABASE_POOL_MAX=10.
# DATABASE_POOL_MAX=10

# --- Stock alerts -----------------------------------------------------------
# The sweep that raises LOW_STOCK and EXPIRY_ALERT notifications. Both conditions
# become true on their own — nothing happens when a reorder level is crossed by a
# consumption entry, and nothing at all happens when an expiry date arrives — so
# something has to look.
#
# IMPORTANT: exactly ONE process should have a non-zero interval. The sweep is a
# singleton by assumption; two instances running it together can both see an item
# as un-alerted and both send. Set this to 0 on every replica but one.
# ALERT_SCAN_INTERVAL_MINUTES=15

# How far ahead an expiry alert looks.
# EXPIRY_ALERT_DAYS=7

# How long one alert about an item silences the next. A low item is still low
# fifteen minutes later, so without this the same row arrives 96 times a day.
# ALERT_COOLDOWN_HOURS=24

# --- JWT --------------------------------------------------------------------
# Minimum 32 characters each, and DIFFERENT from one another.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"

# Keep the access token short-lived: it is stateless, so it cannot be revoked
# before it expires.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=paris-bites-api
JWT_AUDIENCE=paris-bites-web

# --- Password hashing -------------------------------------------------------
# Higher is slower to brute-force but slower to log in. 12 is a sane default
# (~250ms per hash), which is also the login endpoint's natural rate limit.
BCRYPT_SALT_ROUNDS=12

# --- Refresh-token cookie ---------------------------------------------------
# Defaults are derived from NODE_ENV and are correct for both local and
# production; set these only to override.
#
# Locally the app (:4200) and API (:4000) are both on localhost — same site — so
# `lax` works and `secure` must stay off for plain HTTP.
#
# In production Vercel and Railway are DIFFERENT sites, so the cookie must be
# `SameSite=None; Secure` or the browser will not send it at all. That reopens
# CSRF, which is why /auth/refresh and /auth/logout require the
# X-Requested-With header (see requireFetchIntent) — a non-safelisted header
# forces a CORS preflight the browser checks against CORS_ORIGINS.
#
# COOKIE_SAME_SITE=lax      # strict | lax | none   (default: none in prod, lax otherwise)
# COOKIE_SECURE=false       # true | false          (default: true in prod, false otherwise)
# COOKIE_DOMAIN=            # only if the API and app share a parent domain

# --- CORS -------------------------------------------------------------------
# Comma-separated exact origins. No wildcards — credentials are enabled.
CORS_ORIGINS=http://localhost:4200
# Production example:
# CORS_ORIGINS=https://paris-bites.vercel.app,https://inventory.parisbites.com

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Public URLs ------------------------------------------------------------
API_URL=http://localhost:4000
WEB_URL=http://localhost:4200

# --- Seeding (used by `npm run prisma:seed`) --------------------------------
#
# Passwords are never defaulted: a seeded account with a known password is a
# backdoor, and seed scripts have a habit of being run against staging. Each
# account is skipped unless its password is set to at least 10 characters.
#
# Re-running the seed never overwrites an existing account.
SEED_ADMIN_EMAIL=admin@parisbites.local
SEED_ADMIN_PASSWORD=

SEED_MANAGER_EMAIL=manager@parisbites.local
SEED_MANAGER_PASSWORD=

# --- Purchasing ---
# The business own GST state code. Drives CGST+SGST vs IGST on every purchase.
# Two digits, e.g. 27 = Maharashtra, 29 = Karnataka, 07 = Delhi. No default: a wrong
# value misfiles every invoice and is invisible until a return is rejected.
BUSINESS_STATE_CODE=27

# Where uploaded invoice files are written. Local disk — see IFileStorage for the
# S3 swap point. Ephemeral on Railway.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
