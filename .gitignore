# Dependencies
node_modules/

# Build output
dist/
out-tsc/
.angular/

# Environment — secrets never enter git
.env
.env.*
!.env.example

# Generated Prisma client (rebuilt by `prisma generate` on install)
backend/src/generated/

# Logs and coverage
*.log
npm-debug.log*
yarn-error.log*
coverage/

# Editors
.idea/*
!.idea/.gitignore
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db

# Screenshots dropped into the repo while working.
#
# macOS saves these to the working directory by default, and they are 1–2 MB each. Nothing here
# ignores loose images, so a `git add .` commits them permanently into history — where they cannot
# be removed without a rewrite. The product photo masters under design-assets/ are deliberate and
# unaffected.
/Screenshot*.png
/Screen Shot*.png

# Database backups taken before a destructive change. Real order and customer rows —
# business data, never committed. Kept locally so a mistaken delete can be undone.
backend/.backups/
