# ============================================================================
# Frontend environment notes
#
# Angular does NOT read .env files. This project configures the frontend through
# src/environments/*.ts, which the build swaps via `fileReplacements` in
# angular.json.
#
# This file exists only to record what to change per deployment, and to make it
# obvious that no secret belongs on the client:
#
#   An Angular build is a static bundle downloaded by the browser. Anything
#   compiled into it is public. API keys, database URLs and JWT secrets belong
#   exclusively to the backend.
#
# To point the app at a different API:
#   - local development  -> src/environments/environment.development.ts
#   - production         -> src/environments/environment.ts
#
# If you later need build-time values injected from CI instead, generate an
# environment file during the build step rather than importing process.env.
# ============================================================================

# Reference values only — not read by the build.
# API_BASE_URL=http://localhost:4200
